---
import Icon from '../components/Icon.astro';
import { fill } from '../lib/i18n.js';
const { c, ui, lang } = Astro.props;
const r = c.reviews;
const fmt = new Intl.NumberFormat(lang === 'nl' ? 'nl-NL' : 'en-GB');
const rating = r.rating ? r.rating.toLocaleString(lang === 'nl' ? 'nl-NL' : 'en-GB', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : null;
const quotes = (r.highlights ?? []).filter((h) => h.verbatim === true);
---
<section class="section reviews" id="reviews" data-section="reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <h2 id="reviews-title" class="section-title reveal">{ui.reviewsTitle}</h2>
    {rating && (
      <div class="rating reveal">
        <p class="rating-value" aria-hidden="true">{rating}</p>
        <div>
          <p class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <span class={n <= Math.round(r.rating) ? 'on' : ''}><Icon name="star" size={22} /></span>)}</p>
          <p class="rating-line">{fill(ui.ratingLine, { rating, count: fmt.format(r.count ?? 0), source: r.source ?? 'Google' })}</p>
          {r.url && <a class="link" href={r.url} target="_blank" rel="noopener">{ui.readReviews}<Icon name="external" size={16} /></a>}
        </div>
      </div>
    )}
    {quotes.length > 0 && (
      <ul class="quotes">
        {quotes.map((q) => (
          <li class="reveal">
            <blockquote lang={q.lang && q.lang !== 'other' ? q.lang : undefined}><p>“{q.quote}”</p></blockquote>
            <p class="quote-cite">{q.author} · {q.source}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
