---
import { Picture } from 'astro:assets';
import { photo } from '../lib/media.js';
import { t } from '../lib/i18n.js';

/**
 * A client photo, responsive (AVIF/WebP), with a styled empty frame when the file is missing
 * so a demo never shows a broken image. QA flags missing photos separately.
 */
const { image, lang, sizes = '100vw', widths = [480, 800, 1200, 1600, 2000], eager = false, class: cls = '', ratio } = Astro.props;
const src = image ? photo(image.file) : null;
const alt = image ? t(image.alt, lang) : '';
const style = [image?.focus ? `--focus:${image.focus}` : '', ratio ? `--ratio:${ratio}` : ''].filter(Boolean).join(';');
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
    class={`img ${cls}`}
    style={style}
    pictureAttributes={{ class: `pic ${cls}-pic` }}
  />
) : (
  <div class={`img img-missing ${cls}`} style={style} data-missing-photo={image?.file ?? 'none'} aria-hidden="true"></div>
)}
