---
import { fill } from '../lib/i18n.js';
const { c, ui, studio } = Astro.props;
const show = c.mode === 'showcase';
const title = fill(show ? ui.showcase : ui.concept, { name: c.business.name });
const sub = fill(show ? ui.showcaseSub : ui.conceptSub, { studio: studio.name });
---
<aside class="concept" data-concept-ribbon aria-label={title}>
  <p>
    <strong>{title}</strong>
    <span>{sub}</span>
  </p>
</aside>
